public class Main {
    public static void main(String[] args) {
        Chassis chassis = new Chassis();

        // Avanzar a 1.2 m/s
        chassis.setSpeeds(1.2, 1.2);
        System.out.println(chassis);   // Chassis{left=1.200, right=1.200}

        // Girar a la derecha
        chassis.setSpeeds(0.8, 0.3);
        System.out.println(chassis);

        // Detener
        chassis.stop();
        System.out.println(chassis);   // Chassis{left=0.000, right=0.000}
    }
}